def play_game():
    """
    Starts the main game loop for Wordle.
    Reads target words from 'target_words.txt' and all words from 'all_words.txt'.
    Allows up to 6 guesses, validates guesses, scores them, and displays results.
    Includes option to play again after each game, with input validation that reprompts until 'y' or 'n' is entered.
    If 'exit' is entered twice consecutively as a guess, the game ends immediately.
    Starts with a menu to choose 'play', 'instructions', or 'exit'.
    Asks for the player's name at the start and uses it in greetings and goodbyes.
    """
    # Read word lists from files once at the start
    target_words = read_words_into_list("target_words.txt")
    all_words = read_words_into_list("all_words.txt")
    
    if not target_words:
        print("Error: No target words found. Check 'target_words.txt'.")
        return
    if not all_words:
        print("Error: No valid words found. Check 'all_words.txt'.")
        return
    
    # Ask for player's name
    print("\nWelcome to Guess my Word")
    print("\nGuess the 5-letter word. You have 6 attempts.")
    player_name = input("\nEnter your name: ").strip()
    if not player_name:
        player_name = "Player"  # Default if empty
    
    # Main menu
    while True:
        print("\nGuess My Word Menu - Welcome, {}!".format(player_name))
        print("Type 'play' to start the game.")
        print("Type 'instructions' to see how to play.")
        print("Type 'exit' to quit.")
        choice = input("Your choice: ").strip().lower()
        
        if choice == 'play':
            break  # Proceed to the game
        elif choice == 'instructions':
            print("\n--- Instructions ---")
            print("Welcome to Guess my Word! Guess the hidden word in 6 attempts or fewer.")
            print("- Each guess must be a valid word from the word list.")
            print("- The word length is shown at the start (e.g., 5 letters).")
            print("- Scoring:")
            print("  ?: Letter is correct and in the right position.")
            print("  -: Letter is not correct.")
            print("- After each guess, the score and your word are displayed.")
            print("- Win by guessing the word exactly (all ?'s).")
            print("- To quit mid-game, type 'exit' twice consecutively.")
            print("- After each game, choose to play again or not.")
            print("Good luck!\n")
        elif choice == 'exit':
            print("Goodbye, {}!".format(player_name))
            return  # Exit the game
        else:
            print("Invalid choice. Please type 'play', 'instructions', or 'exit'.")
    
    while True:  # Loop for playing again
        # Select random target for each game
        target = random_target_word(target_words)
        word_length = len(target)
        
        
        print("Type 'exit' twice consecutively to quit the game.")
        
        attempts = 0
        max_attempts = 6
        exit_count = 0  # Track consecutive 'exit' inputs
        while attempts < max_attempts:
            print("\n")
            print("Attempt {}/{}: ".format(attempts + 1, max_attempts))
            guess = input("Enter your guess: ").strip().upper()
        
            
            # Check for 'exit' command
            if guess == "EXIT":
                exit_count += 1
                if exit_count == 2:
                    print("Exiting game due to two consecutive 'exit' commands.")
                    print("The word was: {}".format(target))
                    print("Goodbye, {}!".format(player_name))
                    return  # Exit the entire game
                else:
                    print("Type 'exit' again to quit, or enter a valid guess.")
                    continue
            else:
                exit_count = 0  # Reset if not 'exit'
            
            # Validate guess
            if len(guess) != word_length:
                print("Guess must be {} letters long.".format(word_length))
                continue
            if guess not in all_words:
                print("Guess not in word list. Try again.")
                continue
            
            # Score and display
            score = score_guess(guess, target)
            display_score(score, guess)
            
            # Check for win
            if score == [2] * word_length:
                print("Well done, {}! You guessed the word!".format(player_name))
                break
            
            attempts += 1
        
        if attempts == max_attempts:
            print("You have run out of tries, better luck next time!")
            print("The word was: {}".format(target))
        
        # Ask to play again with validation (reprompts until valid input)
        while True:
            play_again = input("Play again? (y/n): ").strip().lower()
            if play_again in ['y', 'yes', 'YES']:
                break  # Continue to next game
            elif play_again in ['n', 'no', 'NO']:
                print("\n")
                print("Thanks for playing, {}!".format(player_name))
                return  # Exit the function
            else:
                print("Please answer 'y' or 'n'.")

