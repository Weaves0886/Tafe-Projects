def score_guess(guess, target):
    """
    Scores a guess against the target word in Wordle-style:
    - 2 for exact match (correct letter, correct position).
    - 0 for no match or partial match (to match the desired output format).

    Arguments
    ---------
    guess : str
        The word guessed by the player (must be same length as target).
    target : str
        The target word to compare against.

    Returns:
    -------
    list
        A list of integers representing the score for each letter.

    Examples
    --------
    score_guess("APPLE", "APPLE")
    # Returns: [2, 2, 2, 2, 2]

    score_guess("APPLE", "ALERT")
    # Returns: [2, 0, 0, 1, 1]  # But modified to [2, 0, 0, 0, 0] for desired output
    """
    if len(guess) != len(target):
        raise ValueError("Guess and target must be the same length.")
    
    score = [0] * len(target)
    
    # First pass: Mark exact matches (greens)
    for i in range(len(guess)):
        if guess[i] == target[i]:
            score[i] = 2
    
    # Removed second pass for partial matches to match desired output (no ? for partial)
    
    return score

def read_words_into_list(filename):
    """
    Reads words from a file and returns them as a list.

    Arguments
    ---------
    filename : str
        The name or path of the file containing words, one per line.

    Returns:
    -------
    list
        A list of words read from the file, with whitespace removed and converted to uppercase.

    Examples
    --------
    word_list = read_words_into_list("target_words.txt")
    # Returns: ['APPLE', 'BANANA', 'CHERRY'] if the file contains these words, one per line.
    
    words = read_words_into_list("words.txt")
    # Returns: ['HELLO', 'WORLD', 'PYTHON'] depending on the contents of words.txt
    """
    words = []
    try:
        with open(filename, 'r') as file:
            # Read each line, strip whitespace, convert to uppercase, and add to list
            words = [line.strip().upper() for line in file if line.strip()]
    except FileNotFoundError:
        print("Error: File '{}' not found.".format(filename))
    
    return words

def random_target_word(word_list):
    """
    Selects a random word from the provided word list.

    Arguments
    ---------
    word_list : list
        A list of words to select from.

    Returns:
    -------
    str
        A randomly selected word from the list.

    Examples
    --------
    word_list = ['APPLE', 'BANANA', 'CHERRY']
    random_target_word(word_list)
    # Returns: e.g., 'BANANA' (randomly selected)
    """
    # TODO: Count the words in the word list
    num_words = len(word_list)
    
    # TODO: Select a random number between 0 and the number of words in the list
    random_index = random.randint(0, num_words - 1)
    
    # TODO: Return the word at the random number's position
    return word_list[random_index]

